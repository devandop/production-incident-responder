NEXT_PUBLIC_POSTHOG_KEY=phc_your_project_api_key
NEXT_PUBLIC_POSTHOG_HOST=https://eu.i.posthog.com

# Optional: push checkout counters to Grafana Cloud (Influx line protocol).
# Use Prometheus Details remote-write host; path must be /api/v1/push/influx/write
# Token is prometheus_instance_id:metrics_write_token (not OTLP / phx keys)
GRAFANA_CLOUD_INFLUX_URL=https://prometheus-prod-XX-....grafana.net/api/v1/push/influx/write
GRAFANA_CLOUD_INFLUX_TOKEN=123456:glc_your_token
