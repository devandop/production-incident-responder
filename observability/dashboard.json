        "type": "timeseries",
        "targets": [
          {
            "datasource": { "type": "prometheus", "uid": "${datasource}" },
            "expr": "sum by (status) (rate(checkout_requests_total[$__rate_interval]))",
            "legendFormat": "{{status}}",
            "refId": "A"
          }
        ]
